# ---- QuantSensei portal configuration (copy to .env) ----
PORTAL_PORT=8080
PORTAL_BASE_URL=http://localhost:8080

# Where the two products run
STOCKSENSEI_URL=http://localhost:8501
QUANTCOPILOT_URL=http://localhost:3000
QUANTCOPILOT_API_URL=http://localhost:8000

# Google sign-in (optional). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials  (type: Web application)
# Authorized redirect URI:  http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
